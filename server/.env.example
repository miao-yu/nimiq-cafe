# Copy to server/.env on the server. .env is gitignored.
#
# Everything below is read through db-config.js, which loads this file by
# absolute path so the cron scripts find it regardless of working directory.
# A missing required value fails loudly at startup rather than surfacing later
# as a MySQL "access denied".

NODE_ENV=PROD

# Database. Two separate MySQL accounts with different grants -- app.js and the
# blockchain scripts connect as `pool`, the social/price scripts as `nimiq`.
# Which script uses which is not interchangeable.
DB_POOL_PASSWORD=
DB_NIMIQ_PASSWORD=
# Optional: default to 127.0.0.1, `pool` and `nimiq`.
# DB_HOST=127.0.0.1
# DB_POOL_USER=pool
# DB_NIMIQ_USER=nimiq

# Signs the 30-day session tokens issued by /api/auth/sign-in. Any long random
# string; `openssl rand -base64 48` is fine. Changing it signs everyone out.
JWT_SECRET=

# CoinMarketCap (scripts/storeCMCPrice.js, scripts/storeCMCRank.js)
CMC_API_KEY=

# Validator monitoring (scripts/checkValidatorStatus.ts)
# The sender domain must be verified in Resend or the send is rejected.
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@nimiq.cafe
ALERT_EMAIL_TO=
# Optional: defaults to the NimiqCafe Staking validator.
# VALIDATOR_ADDRESS=NQ83 4MVH 53Q4 AL3B Q097 55GJ LUQ3 GSF0 85B7
# Optional: how often to re-send while a problem persists. Defaults to 6.
# ALERT_REPEAT_HOURS=6
# Optional: consecutive checks that must agree before an alert or a recovery
# email is sent. At the */5 cron schedule 3 is a ~10 minute window. Defaults to 3.
# ALERT_CONFIRMATIONS=3
# Optional: per-RPC-call timeout in milliseconds. Defaults to 30000.
# RPC_TIMEOUT_MS=30000
