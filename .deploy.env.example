# Copy to .deploy.env (gitignored) so ./deploy.sh knows where to deploy.
#
# DEPLOY_HOST is the only required value; the rest of deploy.sh's settings
# already default correctly and are only here for overrides.

DEPLOY_HOST=user@your-server
# DEPLOY_APP_DIR=/var/www/nimiq-cafe-prod
# DEPLOY_BRANCH=main
# DEPLOY_SITE_URL=https://nimiq.cafe
